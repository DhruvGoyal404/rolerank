# Copy to .env (gitignored). Values must be hex: openssl rand -hex 24
ROLERANK_PG_SUPERUSER_PASSWORD=
ROLERANK_PW_MIGRATOR_APP=
ROLERANK_PW_MIGRATOR_CORPUS=
ROLERANK_PW_APP_RW=
ROLERANK_PW_CORPUS_RW=
ROLERANK_PW_CORPUS_RO=
ROLERANK_VALKEY_PASSWORD=

# Dev OAuth apps, needed by scripts/dev-api.sh. Callback URLs and scopes are in README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Himalayas API key. Server-side only, sent as Authorization: Bearer to himalayas.app alone.
HIMALAYAS_API=

# Resume data (P4): the key-encryption key (32 bytes, base64), the extractor's shared token,
# and the LLM key. aiworker alone reads ANTHROPIC_API_KEY; it is never committed or printed.
ROLERANK_KEK=
ROLERANK_EXTRACTOR_TOKEN=
ANTHROPIC_API_KEY=

# P5: the shared token between the API and aiworker's internal endpoint (32+ characters), and
# the corpus read-only connection the API uses for job detail.
AIWORKER_TOKEN=
