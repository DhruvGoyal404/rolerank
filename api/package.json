{
  "name": "rolerank-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "invite": "node dist/cli/invite.js",
    "aiworker": "node dist/aiworker.js",
    "e2e:server": "tsc -p tsconfig.e2e.json && node .e2e/test/e2e-server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "iovalkey": "0.4.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "rate-limiter-flexible": "11.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "minimatch": "11.0.3"
  }
}
